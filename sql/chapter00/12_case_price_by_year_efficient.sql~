-- ============================================
-- ファイル名: 12_case_price_by_year_efficient.sql
-- 目的:
--   年によって参照する価格列を切り替えて表示する。
--
-- 背景:
--   ItemPrice テーブルには、同じ商品の価格について
--   次の2種類の列がある。
--
--     1. price_tax_ex  … 税抜価格
--     2. price_tax_in  … 税込価格
--
--   今回の仕様は次の通りである。
--
--     - 2003年までは税抜価格を採用する
--     - 2004年以降は税込価格を採用する
--
--   この仕様を、CASE式を使って
--   1回の SELECT の中で表現している。
--
-- ポイント:
--   以前の UNION ALL を使う解法では、
--   ItemPrice テーブルを
--     - year <= 2003 用に1回
--     - year >= 2004 用に1回
--   のように2回読んでいた。
--
--   一方、このCASE式版では
--   ItemPrice を1回読むだけで、
--   各行ごとに「どちらの価格列を採用するか」を決められる。
--
--   そのため、アルゴリズムとしてはこちらの方が自然であり、
--   一般に効率もよい。
-- ============================================

-- ============================================
-- まずは実行計画を確認する
-- ============================================
-- CASE式版は、1本の SELECT の中で
-- 各行に対して条件分岐を行う。
--
-- そのため、UNION ALL 版のように
-- 複数の SELECT を連結する必要がなく、
-- 実行計画上も「1回の表アクセス」で済む形になりやすい。
--
-- MySQL では EXPLAIN を付けることで、
-- オプティマイザがどのようにこのSQLを実行する予定かを確認できる。
--
-- 確認したい点は主に次の通りである。
--
--   1. ItemPrice が何回出てくるか
--      -> CASE式版では通常1回だけになる
--
--   2. access type が何か
--      -> ALL, range, index など
--
--   3. rows がどの程度か
--      -> 推定走査行数
--
--   4. Extra に何が出るか
--      -> Using where など
--
-- 今回のSQLでは WHERE 句が無いため、
-- 単純に全行を読んで、SELECT句の中で CASE を評価する形になる。
--
-- 実行計画確認用:
EXPLAIN
SELECT
    item_name,
    year,
    CASE
        WHEN year <= 2003 THEN price_tax_ex
        WHEN year >= 2004 THEN price_tax_in
        ELSE NULL
    END AS price
FROM ItemPrice;

-- ============================================
-- 実データ取得用SQL
-- ============================================
SELECT
    item_name,
    -- 商品名をそのまま表示する列である。
    --
    -- 例:
    --   カップ
    --   スプーン
    --   ナイフ
    --
    -- この列自体には加工は加えておらず、
    -- ItemPrice テーブルにある item_name をそのまま返している。

    year,
    -- 年をそのまま表示する列である。
    --
    -- この列は CASE 式の判定条件にも使われる。
    -- つまり、どの価格列を採用するかを決めるための
    -- 「分岐キー」の役割を持っている。

    CASE
        -- ここから CASE 式による条件分岐を行う。
        --
        -- CASE 式は SQL における「条件に応じて値を返す式」である。
        -- IF 文のように処理の流れを分けるというより、
        -- 1つの列値を計算するための式と考えると分かりやすい。
        --
        -- 今回は、各行について
        --
        --   その year が 2003 以下か
        --   それとも 2004 以上か
        --
        -- を判定し、返す価格列を切り替えている。
        --
        -- つまりこの CASE 式全体は、
        -- 価格列を年によって選択するための「切替装置」である。

        WHEN year <= 2003 THEN price_tax_ex
        -- year が 2003 以下なら、税抜価格を返す。
        --
        -- 対象となるのは
        --   2002年
        --   2003年
        -- である。
        --
        -- 例えば ItemPrice の行が
        --
        --   item_name = 'カップ'
        --   year = 2002
        --   price_tax_ex = 500
        --   price_tax_in = 525
        --
        -- なら、この分岐では 500 を返す。
        --
        -- つまり、2003年までの旧ルールでは
        -- 税抜価格を採用する仕様を表している。

        WHEN year >= 2004 THEN price_tax_in
        -- year が 2004 以上なら、税込価格を返す。
        --
        -- 対象となるのは
        --   2004年
        --   2005年
        -- である。
        --
        -- 例えば ItemPrice の行が
        --
        --   item_name = 'カップ'
        --   year = 2004
        --   price_tax_ex = 600
        --   price_tax_in = 630
        --
        -- なら、この分岐では 630 を返す。
        --
        -- つまり、2004年以降の新ルールでは
        -- 税込価格を採用する仕様を表している。

        ELSE NULL
        -- 上のどちらの条件にも当てはまらない場合は NULL を返す。
        --
        -- ただし、今回の条件は
        --
        --   year <= 2003
        --   year >= 2004
        --
        -- であり、整数の year に対しては
        -- 実質的に全ての可能な値をカバーしている。
        --
        -- そのため、通常のデータでは ELSE NULL に入ることはない。
        --
        -- ここは「保険」として書かれていると考えるとよい。
        --
        -- たとえば year が NULL である場合など、
        -- 比較結果が真にならないケースでは NULL になる可能性がある。
        --
        -- もっとも、このテーブル定義では year は NOT NULL なので、
        -- 現在の設計上は実質的に到達しない分岐である。
    END AS price
    -- CASE 式全体の結果を price という列名で出力する。
    --
    -- これにより、出力結果では
    --   year に応じて
    --     税抜価格 または 税込価格
    -- のどちらかが price 列に入る。
    --
    -- つまり、この price 列は
    -- 「年に応じて選ばれた最終価格」
    -- という意味を持つ。
    --
    -- 元の列 price_tax_ex や price_tax_in をそのまま見せるのではなく、
    -- 条件分岐後の統一的な結果列として見せている点が重要である。

FROM ItemPrice;
-- ItemPrice テーブルを検索対象にしている。
--
-- このSQLには WHERE 句が無いため、
-- テーブル内の全行が対象になる。
--
-- ただし、UNION ALL 版と違って
-- 「年で2つの集合に分けて別々に取得する」のではなく、
-- 1行ずつ読みながら、その場で CASE 式を評価する。
--
-- つまり、表走査は1回で済み、
-- 各行に対して
--   year を確認
--   -> 採用する価格列を選ぶ
-- という処理をしている。

-- ============================================
-- このSQLのアルゴリズム
-- ============================================
--
-- このSQLのアルゴリズムを1行単位で考えると次の通りである。
--
-- 1. ItemPrice テーブルから1行読む
-- 2. その行の year を確認する
-- 3. year <= 2003 なら price_tax_ex を選ぶ
-- 4. そうでなければ year >= 2004 と判定し、price_tax_in を選ぶ
-- 5. 選んだ値を price として出力する
-- 6. item_name, year と一緒に結果へ返す
--
-- これを全行に対して繰り返す。
--
-- つまり本質的には、
--
--   「各行を1回だけ見て、年に応じて返す価格列を切り替える」
--
-- という単純な行単位アルゴリズムである。
--
-- 図にすると、考え方は次のようになる。
--
--   ItemPrice の1行を読む
--          |
--          v
--      year を確認
--      /        \
--     /          \
--    v            v
-- year <= 2003   year >= 2004
--    |               |
--    v               v
-- price_tax_ex   price_tax_in
--    \               /
--     \             /
--      v           v
--         price として出力
--
-- この「1回読んで、その場で分岐する」という構造が、
-- UNION ALL 版との大きな違いである。

-- ============================================
-- なぜ UNION ALL 版より自然なのか
-- ============================================
--
-- UNION ALL 版では、
--
--   SELECT ... WHERE year <= 2003
--   UNION ALL
--   SELECT ... WHERE year >= 2004
--
-- というように、
-- 仕様を2つの結果集合に分割してから最後に連結していた。
--
-- これは発想としては
--   「古い年グループ」
--   「新しい年グループ」
-- を別々に集める方法である。
--
-- しかし今回の問題は、実際には
-- 「各行について、どちらの価格列を使うか決めるだけ」
-- である。
--
-- そのため、行ごとの条件分岐を直接表現する CASE 式の方が、
-- 問題構造に合っている。
--
-- つまり、
--
--   問題の本質:
--     行単位の価格列選択
--
--   CASE式:
--     行単位の分岐をそのまま書ける
--
--   UNION ALL:
--     行集合を2つに分けてから再結合する
--
-- となり、CASE 式の方が素直である。

-- ============================================
-- 効率面での違い
-- ============================================
--
-- CASE 式版が効率面で有利になりやすい理由は、
-- 同じテーブルを2回読まなくてよいからである。
--
-- UNION ALL 版では、
--   1本目の SELECT で ItemPrice を読む
--   2本目の SELECT で ItemPrice を読む
-- と、同一テーブルへのアクセスが2回発生する。
--
-- 一方、CASE 式版では、
--   ItemPrice を1回読み、
--   読んだ各行について CASE を評価する
-- だけである。
--
-- データ量が小さいうちは差が小さく見えるが、
-- テーブルが大きくなると
--   I/O
--   CPU
--   バッファ利用
-- などの面で差が広がりやすい。
--
-- したがって、今回のような
-- 「1行の中で列を選ぶだけ」の問題では、
-- CASE 式の方が一般に効率的である。

-- ============================================
-- CASE式の条件の書き方について
-- ============================================
--
-- このSQLでは
--
--   WHEN year <= 2003 THEN ...
--   WHEN year >= 2004 THEN ...
--
-- と2条件を書いている。
--
-- 実際には、year が整数で NOT NULL なら
-- 1つ目が偽なら2つ目が真になるため、
-- 次のように書いても意味は同じである。
--
--   CASE
--       WHEN year <= 2003 THEN price_tax_ex
--       ELSE price_tax_in
--   END
--
-- ただし、今回の書き方は
--   2003年まで
--   2004年から
-- という仕様の境界を明示しているので、
-- 学習用としては分かりやすい。
--
-- 一方で、冗長さを減らしたい場合は
-- ELSE にまとめる書き方もよく使われる。

-- ============================================
-- このSQLが返す結果の意味
-- ============================================
--
-- 出力列は次の3つである。
--
--   item_name
--   year
--   price
--
-- このうち price は、元のテーブルにある単一列ではなく、
-- CASE 式によって作られた導出列である。
--
-- その意味は次の通りである。
--
--   2003年以下では税抜価格
--   2004年以上では税込価格
--
-- したがって price 列は、
-- 「年に応じた採用価格」
-- と理解するとよい。
--
-- 例:
--
--   カップ 2002 -> 500   （税抜価格）
--   カップ 2004 -> 630   （税込価格）
--
-- このように、同じ price 列でも
-- year に応じて参照元が切り替わっている。

-- ============================================
-- 実務上の注意
-- ============================================
--
-- 1. 行ごとの単純な分岐は CASE 式で書くのが基本である
--    結果集合を分ける必要がない場合は、
--    UNION より CASE の方が自然で読みやすい。
--
-- 2. 実行計画を確認して表アクセス回数を見ること
--    特に UNION を使った場合は、
--    同じテーブルを何回読んでいるかを意識する。
--
-- 3. ELSE NULL が本当に必要か確認すること
--    今回の設計では year が NOT NULL かつ整数なので、
--    実質的には ELSE に到達しない。
--    そのため、簡略化の余地がある。
--
-- 4. price 列の意味をコメントで残すと親切である
--    年によって税抜と税込が切り替わるため、
--    後から読む人が誤解しないようにしておくとよい。
--
-- 5. 境界条件の年を変更する可能性があるなら定数管理も検討する
--    たとえば 2003 / 2004 が仕様変更で変わるなら、
--    SQL中に直接書くより管理方法を考える余地がある。
